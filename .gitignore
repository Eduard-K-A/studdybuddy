# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents
# `npx skills add` mirrors every skill into one directory per agent tool.
# vibe-starter ignores the first two; the rest are the same content again.
.agents/skills
.claude/skills
.codebuddy/skills
.kiro/skills
.trae/skills
.windsurf/skills

# ibl.ai platform config — holds TOKEN (platform API key).
# NOT covered by the `.env*` rule above: that only matches names starting
# with ".env", and this file does not. Committing it leaks the token.
iblai.env

# playwright-mcp scratch output (snapshots, console logs)
.playwright-mcp/

# Playwright auth storage state (contains live session tokens) and run output
/playwright/
/test-results/
/playwright-report/

# Tauri build output
/src-tauri/target/
/src-tauri/gen/
