# ibl.ai Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
NEXT_PUBLIC_BASE_WS_URL=wss://asgi.data.iblai.app
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app
IBLAI_API_KEY=your-token
NEXT_PUBLIC_MAIN_TENANT_KEY=your-platform

# StudyBuddy — server-side only, never exposed to the browser.
# The agent (mentor) the quiz runs against, and the ibl.ai username the
# agent WebSocket frame is addressed to.
IBLAI_AGENT_ID=your-agent-id
IBLAI_USERNAME=your-ibl-username

# Force the offline practice agent instead of calling ibl.ai.
# Set to "stub" for CI, E2E, and local work that should not spend credits.
# Leave unset to use the live agent, which falls back to offline automatically
# if the platform has no credit balance.
QUIZ_AGENT=
