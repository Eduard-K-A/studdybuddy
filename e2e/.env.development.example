# Playwright E2E credentials.
#
# Copy to `e2e/.env.development` and fill in. That file is gitignored by the
# `.env*` rule; this .example is the committed template.
#
#   cp e2e/.env.development.example e2e/.env.development
#
# The suite logs in through the real ibl.ai auth SPA (e2e/auth.setup.ts) and
# saves the resulting storage state, so journey specs run authenticated.
# Use a throwaway/test account where you can — these are real credentials.

APP_HOST=http://localhost:3000
AUTH_HOST=https://login.iblai.app

PLAYWRIGHT_USERNAME=
PLAYWRIGHT_PASSWORD=
